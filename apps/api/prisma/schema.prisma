// HAMMER LOGISTICS — Phase 1 schema
// Business rules that Prisma cannot express (CHECK constraints, partial unique
// indexes, composite rules per shipment type) live in the SQL of the first migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Department {
  MANAGEMENT
  SCAN
  OPERATION
  NAFEZA
  ACCOUNTS
  AGENTS
}

enum EmployeeStatus {
  ACTIVE
  LEFT
}

enum AccountType {
  EMPLOYEE
  CLEARER
}

enum Direction {
  IMPORT
  EXPORT
}

enum ShipmentMode {
  SEA
  AIR
  FREE_ZONE
}

enum CustomsRegime {
  FINAL
  TEMPORARY
}

enum LoadType {
  FCL
  LCL
}

enum ContainerType {
  HQ20
  HQ40
  LCL
}

enum TransportKind {
  SEA
  AIR
}

enum Currency {
  EGP
  USD
}

enum MoneyAccountType {
  CASH
  BANK
}

enum MoneyDirection {
  IN
  OUT
}

/// The document a money movement belongs to; each value has its own FK column.
enum MovementSource {
  TRANSFER
  OTHER
  SALARY
  ADVANCE
  EXPENSE
  CUSTODY
  FEE_PAYMENT
  COLLECTION
}

/// Who holds a custody: an agents-department employee, WAY OUT, the shipment's clearer, or no one (a direct bank payment).
enum CustodyHolder {
  AGENT
  WAY_OUT
  CLEARER
  BANK_TRANSFER
}

/// تفريغ / صرف / أرضيات / تخليص
enum CustodyPurpose {
  UNLOADING
  RELEASE
  STORAGE
  CLEARANCE
}

enum CustodyStatus {
  OPEN
  SETTLED
}

/// Who an external bank account belongs to.
enum BeneficiaryKind {
  SHIPPING_AGENCY
  CLEARER
  OTHER
}

/// The document a settlement line stands for; it sets the line printed on the statement.
enum ReceiptKind {
  PAYMENT_RECEIPT
  PAYMENT
  VAT
}

enum ShipmentAccountStatus {
  OPEN
  FINISHED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum InvoiceType {
  STATEMENT
  CLEARANCE
}

enum CollectionMethod {
  CASH
  TRANSFER
}

enum FeeAdjustmentReason {
  CONTAINERS_CHANGED
  CEO_OVERRIDE
}

enum ExpenseScope {
  GENERAL
  SHIPMENT
}

/// Funding from management (in), bank charges (out), corrections (either way).
enum OtherMovementKind {
  FUNDING
  BANK_CHARGES
  ADJUSTMENT
}

/// Review (accountant) → manager approval → final approval (general auditor).
enum ApprovalStatus {
  PENDING
  REVIEWED
  MANAGER_APPROVED
  APPROVED
  REJECTED
}

/// Every stage of every shipment type. The ordered list per type lives in code.
enum ShipmentStage {
  REGISTERED
  // import sea / air
  IN_TRANSIT
  ARRIVED
  UNLOADING
  UNLOADED
  RECEIVED_AT_WAREHOUSE
  DO_COLLECTED
  // customs (import, all types)
  SUBMITTED
  EXAMINATION
  INSPECTION
  VALUATION
  APPROVAL_PENDING
  APPROVED
  DUTIES_PAID
  RELEASE_DELIVERED
  CLEARED
  // export
  DELIVERED_TO_PORT
  RELEASE_RECEIVED
  SHIPPED
  ARRIVED_DESTINATION
  DELIVERED_TO_IMPORTER
}

// ───────────────────────── Users & people ─────────────────────────

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  permissions String[]
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model Employee {
  id          Int            @id @default(autoincrement())
  code        String // = user id on the ZKTeco device
  fullName    String         @map("full_name")
  nationalId  String         @map("national_id")
  phone       String
  address     String?
  department  Department
  jobTitle    String         @map("job_title")
  hireDate    DateTime       @map("hire_date") @db.Date
  status      EmployeeStatus @default(ACTIVE)
  leaveDate   DateTime?      @map("leave_date") @db.Date
  basicSalary Decimal        @default(0) @map("basic_salary") @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")
  deletedById Int?           @map("deleted_by")

  deletedBy         User?             @relation("EmployeeDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  users             User[]            @relation("UserEmployee")
  attendanceLogs    AttendanceLog[]
  importClients     Client[]          @relation("ClientImportOperation")
  exportClients     Client[]          @relation("ClientExportOperation")
  operatedShipments Shipment[]        @relation("ShipmentOperation")
  salaryPayments    SalaryPayment[]
  advances          EmployeeAdvance[]
  custodies         Custody[]

  @@index([department, status])
  @@map("employees")
}

model Clearer {
  id                   Int       @id @default(autoincrement())
  fullName             String    @map("full_name")
  phone                String
  nationalId           String    @map("national_id")
  customsOffices       String[]  @map("customs_offices")
  // fee prices — set and changed by the CEO only
  importFinalBase      Decimal   @map("import_final_base") @db.Decimal(14, 2)
  importTemporaryBase  Decimal   @map("import_temporary_base") @db.Decimal(14, 2)
  importExtraContainer Decimal   @map("import_extra_container") @db.Decimal(14, 2)
  exportBase           Decimal   @map("export_base") @db.Decimal(14, 2)
  exportExtraContainer Decimal   @map("export_extra_container") @db.Decimal(14, 2)
  isActive             Boolean   @default(true) @map("is_active")
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")
  deletedById          Int?      @map("deleted_by")

  deletedBy     User?         @relation("ClearerDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  users         User[]        @relation("UserClearer")
  shipments     Shipment[]
  custodies     Custody[]
  fees          ClearerFee[]
  beneficiaries Beneficiary[]

  @@map("clearers")
}

model User {
  id             Int         @id @default(autoincrement())
  email          String // login; must end with @hammerline.com
  passwordHash   String      @map("password_hash")
  roleId         Int         @map("role_id")
  isActive       Boolean     @default(true) @map("is_active")
  accountType    AccountType @map("account_type")
  employeeId     Int?        @map("employee_id")
  clearerId      Int?        @map("clearer_id")
  failedAttempts Int         @default(0) @map("failed_attempts")
  lockedUntil    DateTime?   @map("locked_until")
  sessionId      String?     @map("session_id") // one active session; a new login replaces it
  lastLoginAt    DateTime?   @map("last_login_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")
  deletedById    Int?        @map("deleted_by")

  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  employee  Employee? @relation("UserEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  clearer   Clearer?  @relation("UserClearer", fields: [clearerId], references: [id], onDelete: Restrict)
  deletedBy User?     @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  deletedUsers      User[]             @relation("UserDeletedBy")
  deletedEmployees  Employee[]         @relation("EmployeeDeletedBy")
  deletedClearers   Clearer[]          @relation("ClearerDeletedBy")
  deletedClients    Client[]           @relation("ClientDeletedBy")
  deletedFactories  Factory[]          @relation("FactoryDeletedBy")
  createdShipments  Shipment[]         @relation("ShipmentCreatedBy")
  uploadedDocuments ShipmentDocument[] @relation("DocumentUploadedBy")
  deletedDocuments  ShipmentDocument[] @relation("DocumentDeletedBy")
  auditLogs         AuditLog[]

  moneyMovements         MoneyMovement[]        @relation("MovementCreatedBy")
  createdTransfers       Transfer[]             @relation("TransferCreatedBy")
  reviewedTransfers      Transfer[]             @relation("TransferReviewedBy")
  managedTransfers       Transfer[]             @relation("TransferManagerBy")
  approvedTransfers      Transfer[]             @relation("TransferApprovedBy")
  rejectedTransfers      Transfer[]             @relation("TransferRejectedBy")
  createdOtherMovements  OtherMovement[]        @relation("OtherCreatedBy")
  reviewedOtherMovements OtherMovement[]        @relation("OtherReviewedBy")
  managedOtherMovements  OtherMovement[]        @relation("OtherManagerBy")
  approvedOtherMovements OtherMovement[]        @relation("OtherApprovedBy")
  rejectedOtherMovements OtherMovement[]        @relation("OtherRejectedBy")
  createdSalaries        SalaryPayment[]        @relation("SalaryCreatedBy")
  reviewedSalaries       SalaryPayment[]        @relation("SalaryReviewedBy")
  managedSalaries        SalaryPayment[]        @relation("SalaryManagerBy")
  approvedSalaries       SalaryPayment[]        @relation("SalaryApprovedBy")
  rejectedSalaries       SalaryPayment[]        @relation("SalaryRejectedBy")
  createdAdvances        EmployeeAdvance[]      @relation("AdvanceCreatedBy")
  reviewedAdvances       EmployeeAdvance[]      @relation("AdvanceReviewedBy")
  managedAdvances        EmployeeAdvance[]      @relation("AdvanceManagerBy")
  approvedAdvances       EmployeeAdvance[]      @relation("AdvanceApprovedBy")
  rejectedAdvances       EmployeeAdvance[]      @relation("AdvanceRejectedBy")
  createdExpenses        GeneralExpense[]       @relation("ExpenseCreatedBy")
  reviewedExpenses       GeneralExpense[]       @relation("ExpenseReviewedBy")
  managedExpenses        GeneralExpense[]       @relation("ExpenseManagerBy")
  approvedExpenses       GeneralExpense[]       @relation("ExpenseApprovedBy")
  rejectedExpenses       GeneralExpense[]       @relation("ExpenseRejectedBy")
  createdCustodies       Custody[]              @relation("CustodyCreatedBy")
  reviewedCustodies      Custody[]              @relation("CustodyReviewedBy")
  managedCustodies       Custody[]              @relation("CustodyManagerBy")
  approvedCustodies      Custody[]              @relation("CustodyApprovedBy")
  rejectedCustodies      Custody[]              @relation("CustodyRejectedBy")
  settledCustodies       Custody[]              @relation("CustodySettledBy")
  createdFeeAdjustments  ClearerFeeAdjustment[] @relation("FeeAdjCreatedBy")
  reviewedFeeAdjustments ClearerFeeAdjustment[] @relation("FeeAdjReviewedBy")
  managedFeeAdjustments  ClearerFeeAdjustment[] @relation("FeeAdjManagerBy")
  approvedFeeAdjustments ClearerFeeAdjustment[] @relation("FeeAdjApprovedBy")
  rejectedFeeAdjustments ClearerFeeAdjustment[] @relation("FeeAdjRejectedBy")
  createdFeePayments     ClearerFeePayment[]    @relation("FeePayCreatedBy")
  reviewedFeePayments    ClearerFeePayment[]    @relation("FeePayReviewedBy")
  managedFeePayments     ClearerFeePayment[]    @relation("FeePayManagerBy")
  approvedFeePayments    ClearerFeePayment[]    @relation("FeePayApprovedBy")
  rejectedFeePayments    ClearerFeePayment[]    @relation("FeePayRejectedBy")
  computedFees           ClearerFee[]           @relation("FeeComputedBy")
  createdBeneficiaries   Beneficiary[]          @relation("BeneficiaryCreatedBy")
  createdInvoices        Invoice[]              @relation("InvoiceCreatedBy")
  reviewedInvoices       Invoice[]              @relation("InvoiceReviewedBy")
  managedInvoices        Invoice[]              @relation("InvoiceManagerBy")
  approvedInvoices       Invoice[]              @relation("InvoiceApprovedBy")
  rejectedInvoices       Invoice[]              @relation("InvoiceRejectedBy")
  voidedInvoices         Invoice[]              @relation("InvoiceVoidedBy")
  createdCollections     Collection[]           @relation("CollectionCreatedBy")
  reviewedCollections    Collection[]           @relation("CollectionReviewedBy")
  managedCollections     Collection[]           @relation("CollectionManagerBy")
  approvedCollections    Collection[]           @relation("CollectionApprovedBy")
  rejectedCollections    Collection[]           @relation("CollectionRejectedBy")
  finishedAccounts       ShipmentAccount[]      @relation("AccountFinishedBy")
  statementOverrides     StatementOverride[]    @relation("OverrideBy")
  statementExtras        StatementExtraLine[]   @relation("ExtraLineBy")

  @@map("users")
}

model AttendanceLog {
  id           Int      @id @default(autoincrement())
  deviceSn     String   @map("device_sn")
  employeeCode String   @map("employee_code")
  employeeId   Int?     @map("employee_id")
  punchedAt    DateTime @map("punched_at")
  punchType    String?  @map("punch_type")
  createdAt    DateTime @default(now()) @map("created_at")

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([deviceSn, employeeCode, punchedAt])
  @@index([employeeId, punchedAt])
  @@map("attendance_logs")
}

// ───────────────────────── Clients & factories ─────────────────────────

model Client {
  id                        Int       @id @default(autoincrement())
  name                      String
  mobile                    String
  email                     String
  importOperationEmployeeId Int       @map("import_operation_employee_id")
  exportOperationEmployeeId Int?      @map("export_operation_employee_id")
  // CLEARANCE quotation
  quoteFinalBase            Decimal   @map("quote_final_base") @db.Decimal(14, 2)
  quoteTemporaryBase        Decimal   @map("quote_temporary_base") @db.Decimal(14, 2)
  quoteImportExtraContainer Decimal   @map("quote_import_extra_container") @db.Decimal(14, 2)
  quoteExportBase           Decimal   @map("quote_export_base") @db.Decimal(14, 2)
  quoteExportExtraContainer Decimal   @map("quote_export_extra_container") @db.Decimal(14, 2)
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  deletedAt                 DateTime? @map("deleted_at")
  deletedById               Int?      @map("deleted_by")

  importOperationEmployee Employee     @relation("ClientImportOperation", fields: [importOperationEmployeeId], references: [id], onDelete: Restrict)
  exportOperationEmployee Employee?    @relation("ClientExportOperation", fields: [exportOperationEmployeeId], references: [id], onDelete: Restrict)
  deletedBy               User?        @relation("ClientDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  factories               Factory[]
  shipments               Shipment[]
  collections             Collection[]

  @@map("clients")
}

model Factory {
  id                 Int       @id @default(autoincrement())
  clientId           Int       @map("client_id")
  name               String
  taxNumber          String    @map("tax_number")
  commercialRegister String    @map("commercial_register")
  address            String
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  deletedById        Int?      @map("deleted_by")

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  deletedBy User?      @relation("FactoryDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  shipments Shipment[]

  @@unique([id, clientId]) // target of the composite FK that ties a shipment's factory to its client
  @@index([clientId])
  @@map("factories")
}

// ───────────────────────────── Lookups ─────────────────────────────

model Country {
  id     Int    @id @default(autoincrement())
  code   String @unique // ISO 3166-1 alpha-2
  nameAr String @map("name_ar")
  nameEn String @map("name_en")

  ports     Port[]
  shipments Shipment[]

  @@map("countries")
}

model Port {
  id         Int           @id @default(autoincrement())
  name       String
  code       String?       @unique // UN/LOCODE or IATA
  kind       TransportKind
  countryId  Int           @map("country_id")
  isEgyptian Boolean       @default(false) @map("is_egyptian")

  country            Country       @relation(fields: [countryId], references: [id], onDelete: Restrict)
  loadingShipments   Shipment[]    @relation("ShipmentLoadingPort")
  dischargeShipments Shipment[]    @relation("ShipmentDischargePort")
  storageYards       StorageYard[]

  @@unique([kind, name])
  @@map("ports")
}

model Carrier {
  id        Int           @id @default(autoincrement())
  name      String
  kind      TransportKind // SEA = shipping line, AIR = airline
  sortOrder Int           @default(1000) @map("sort_order") // lists show the busiest first

  shipments Shipment[]

  @@unique([kind, name])
  @@map("carriers")
}

model FreeZone {
  id   Int    @id @default(autoincrement())
  name String @unique

  shipments Shipment[]

  @@map("free_zones")
}

model StorageYard {
  id     Int           @id @default(autoincrement())
  name   String
  kind   TransportKind // SEA = yard / container terminal, AIR = airport warehouse
  portId Int?          @map("port_id") // the Egyptian port / airport the yard belongs to

  port      Port?      @relation(fields: [portId], references: [id], onDelete: Restrict)
  shipments Shipment[]

  @@unique([kind, name])
  @@map("storage_yards")
}

model InspectionAuthority {
  id   Int    @id @default(autoincrement())
  name String @unique

  @@map("inspection_authorities")
}

// ───────────────────────────── Shipments ─────────────────────────────

model Shipment {
  id                  Int            @id @default(autoincrement())
  fileNo              String         @unique @map("file_no") // HL26-0001
  direction           Direction
  mode                ShipmentMode
  clientId            Int            @map("client_id")
  factoryId           Int            @map("factory_id")
  clearerId           Int            @map("clearer_id")
  operationEmployeeId Int            @map("operation_employee_id")
  foreignPartyName    String         @map("foreign_party_name") // supplier (import) / importer (export)
  countryId           Int            @map("country_id") // origin (import) / destination (export)
  consignee           String
  commodity           String
  customsRegime       CustomsRegime? @map("customs_regime") // import only
  packagesCount       Int            @map("packages_count")
  totalWeight         Decimal        @map("total_weight") @db.Decimal(14, 3)
  notificationDate    DateTime       @map("notification_date") @db.Date

  // shipping
  carrierId       Int?      @map("carrier_id")
  hblNumber       String?   @map("hbl_number") // empty → shown/printed as MB/L
  mblNumber       String?   @map("mbl_number")
  referenceNumber String?   @unique @map("reference_number") // ACID (import) / UCR (export), 19 digits
  voyageNo        String?   @map("voyage_no")
  bookingNo       String?   @map("booking_no")
  loadingPortId   Int?      @map("loading_port_id")
  dischargePortId Int?      @map("discharge_port_id")
  freeZoneId      Int?      @map("free_zone_id")
  loadType        LoadType? @map("load_type")
  containersCount Int?      @map("containers_count")

  // operation
  vesselName String?   @map("vessel_name")
  eta        DateTime? @db.Date

  // customs (Nafeza) tab
  certificateNo       String?   @map("certificate_no")
  certificateDate     DateTime? @map("certificate_date") @db.Date
  deliveryOrderDate   DateTime? @map("delivery_order_date") @db.Date
  form46Date          DateTime? @map("form46_date") @db.Date
  storageYardId       Int?      @map("storage_yard_id")
  examinationDate     DateTime? @map("examination_date") @db.Date
  inspectionDate      DateTime? @map("inspection_date") @db.Date
  approvalDate        DateTime? @map("approval_date") @db.Date
  paymentDate         DateTime? @map("payment_date") @db.Date
  releaseDate         DateTime? @map("release_date") @db.Date // import: تاريخ الصرف
  deliveredToPortDate DateTime? @map("delivered_to_port_date") @db.Date // export
  releaseReceivedDate DateTime? @map("release_received_date") @db.Date // export
  shippedDate         DateTime? @map("shipped_date") @db.Date // export

  currentStage ShipmentStage @default(REGISTERED) @map("current_stage")
  stageHistory Json          @default("[]") @map("stage_history") // [{from,to,movement,at,by,reason}]
  inspections  Json          @default("[]") // [{authorityId,requestedAt,result,resultDate,notes}]

  version     Int      @default(0) // optimistic locking
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  client            Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  factory           Factory      @relation(fields: [factoryId, clientId], references: [id, clientId], onDelete: Restrict)
  clearer           Clearer      @relation(fields: [clearerId], references: [id], onDelete: Restrict)
  operationEmployee Employee     @relation("ShipmentOperation", fields: [operationEmployeeId], references: [id], onDelete: Restrict)
  country           Country      @relation(fields: [countryId], references: [id], onDelete: Restrict)
  carrier           Carrier?     @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  loadingPort       Port?        @relation("ShipmentLoadingPort", fields: [loadingPortId], references: [id], onDelete: Restrict)
  dischargePort     Port?        @relation("ShipmentDischargePort", fields: [dischargePortId], references: [id], onDelete: Restrict)
  freeZone          FreeZone?    @relation(fields: [freeZoneId], references: [id], onDelete: Restrict)
  storageYard       StorageYard? @relation(fields: [storageYardId], references: [id], onDelete: Restrict)
  createdBy         User         @relation("ShipmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  containers      ShipmentContainer[]
  billNumbers     BillNumber[]
  documents       ShipmentDocument[]
  custodies       Custody[]
  clearerFee      ClearerFee?
  account         ShipmentAccount?
  statementExtras StatementExtraLine[]
  invoices        Invoice[]
  collections     Collection[]

  @@index([clientId])
  @@index([operationEmployeeId])
  @@index([clearerId])
  @@index([currentStage])
  @@map("shipments")
}

model ShipmentContainer {
  id          Int           @id @default(autoincrement())
  shipmentId  Int           @map("shipment_id")
  seq         Int // 1..10
  containerNo String?       @map("container_no") // optional for LCL
  type        ContainerType
  weight      Decimal       @db.Decimal(14, 3)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, seq])
  @@index([containerNo])
  @@map("shipment_containers")
}

/// Every HB/L and MB/L number, once. Blocks the same number on two shipments in
/// either column, while HB/L = MB/L on the same shipment is stored once.
model BillNumber {
  number     String @id
  shipmentId Int    @map("shipment_id")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("bill_numbers")
}

/// مستند / تسوية / إيصال
enum DocumentCategory {
  DOCUMENT
  SETTLEMENT
  RECEIPT
}

model ShipmentDocument {
  id           Int              @id @default(autoincrement())
  shipmentId   Int              @map("shipment_id")
  name         String // typed by the uploader
  category     DocumentCategory @default(DOCUMENT)
  fileName     String           @map("file_name")
  url          String
  publicId     String           @map("public_id") // Cloudinary
  mimeType     String           @map("mime_type")
  size         Int
  uploadedById Int              @map("uploaded_by")
  createdAt    DateTime         @default(now()) @map("created_at")
  deletedAt    DateTime?        @map("deleted_at")
  deletedById  Int?             @map("deleted_by")

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  uploadedBy User     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  deletedBy  User?    @relation("DocumentDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@map("shipment_documents")
}

// ───────────────────────────── System ─────────────────────────────

/// Gap-free counters, e.g. key "file_no:26" → last used number of 2026.
model Sequence {
  key   String @id
  value Int    @default(0)

  @@map("sequences")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String // CREATE / UPDATE / DELETE / LOGIN / STAGE_MOVE ...
  entity    String
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ───────────────────────── Finance: treasury and banks ─────────────────────────
// Every document that moves money writes one line per account in money_movements,
// and updates the account balance, in the same transaction.

/// The two cash boxes (one per currency) and the bank accounts.
model MoneyAccount {
  id             Int              @id @default(autoincrement())
  name           String
  type           MoneyAccountType
  currency       Currency
  bankName       String?          @map("bank_name")
  accountNumber  String?          @map("account_number")
  openingBalance Decimal          @default(0) @map("opening_balance") @db.Decimal(14, 2)
  balance        Decimal          @default(0) @db.Decimal(14, 2) // opening + movements; CHECK >= 0
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  movements        MoneyMovement[]
  transfersOut     Transfer[]          @relation("TransferFrom")
  transfersIn      Transfer[]          @relation("TransferTo")
  otherMovements   OtherMovement[]
  salaryPayments   SalaryPayment[]
  employeeAdvances EmployeeAdvance[]
  generalExpenses  GeneralExpense[]
  custodies        Custody[]
  feePayments      ClearerFeePayment[]
  collections      Collection[]

  @@unique([id, currency]) // target of the composite FKs that lock a document's currency
  @@map("money_accounts")
}

/// The money ledger: append-only (trigger). A correction is a reversal line.
model MoneyMovement {
  id              BigInt         @id @default(autoincrement())
  accountId       Int            @map("account_id")
  direction       MoneyDirection
  amount          Decimal        @db.Decimal(14, 2) // > 0
  balanceAfter    Decimal        @map("balance_after") @db.Decimal(14, 2)
  movementDate    DateTime       @map("movement_date") @db.Date
  source          MovementSource
  transferId      Int?           @map("transfer_id")
  otherMovementId Int?           @map("other_movement_id")
  salaryId        Int?           @map("salary_id")
  advanceId       Int?           @map("advance_id")
  expenseId       Int?           @map("expense_id")
  custodyId       Int?           @map("custody_id")
  feePaymentId    Int?           @map("fee_payment_id")
  collectionId    Int?           @map("collection_id")
  reversalOfId    BigInt?        @unique @map("reversal_of_id")
  createdById     Int            @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")

  account       MoneyAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transfer      Transfer?          @relation(fields: [transferId], references: [id], onDelete: Restrict)
  otherMovement OtherMovement?     @relation(fields: [otherMovementId], references: [id], onDelete: Restrict)
  salary        SalaryPayment?     @relation(fields: [salaryId], references: [id], onDelete: Restrict)
  advance       EmployeeAdvance?   @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  expense       GeneralExpense?    @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  custody       Custody?           @relation(fields: [custodyId], references: [id], onDelete: Restrict)
  feePayment    ClearerFeePayment? @relation(fields: [feePaymentId], references: [id], onDelete: Restrict)
  collection    Collection?        @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  reversalOf    MoneyMovement?     @relation("MovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy    MoneyMovement?     @relation("MovementReversal")
  createdBy     User               @relation("MovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([accountId, id])
  @@index([transferId])
  @@index([otherMovementId])
  @@index([salaryId])
  @@index([advanceId])
  @@index([expenseId])
  @@index([custodyId])
  @@index([feePaymentId])
  @@index([collectionId])
  @@map("money_movements")
}

/// Cash → bank (deposit), bank → cash (cheque withdrawal) or bank → bank. Same currency always.
model Transfer {
  id            Int      @id @default(autoincrement())
  fromAccountId Int      @map("from_account_id")
  toAccountId   Int      @map("to_account_id")
  currency      Currency
  amount        Decimal  @db.Decimal(14, 2)
  chequeNo      String?  @map("cheque_no")
  transferDate  DateTime @map("transfer_date") @db.Date
  notes         String?

  approvalStatus  ApprovalStatus @default(PENDING) @map("approval_status")
  reviewedById    Int?           @map("reviewed_by")
  reviewedAt      DateTime?      @map("reviewed_at")
  managerById     Int?           @map("manager_by")
  managerAt       DateTime?      @map("manager_at")
  approvedById    Int?           @map("approved_by")
  approvedAt      DateTime?      @map("approved_at")
  rejectedById    Int?           @map("rejected_by")
  rejectedAt      DateTime?      @map("rejected_at")
  rejectionReason String?        @map("rejection_reason")
  version         Int            @default(0)
  createdById     Int            @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  fromAccount MoneyAccount    @relation("TransferFrom", fields: [fromAccountId, currency], references: [id, currency], onDelete: Restrict)
  toAccount   MoneyAccount    @relation("TransferTo", fields: [toAccountId, currency], references: [id, currency], onDelete: Restrict)
  movements   MoneyMovement[]
  createdBy   User            @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy  User?           @relation("TransferReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  managerBy   User?           @relation("TransferManagerBy", fields: [managerById], references: [id], onDelete: Restrict)
  approvedBy  User?           @relation("TransferApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy  User?           @relation("TransferRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)

  @@index([approvalStatus])
  @@map("transfers")
}

/// Funding, bank charges and corrections on one account; the reason is required.
model OtherMovement {
  id           Int               @id @default(autoincrement())
  accountId    Int               @map("account_id")
  kind         OtherMovementKind
  direction    MoneyDirection
  amount       Decimal           @db.Decimal(14, 2)
  reason       String
  movementDate DateTime          @map("movement_date") @db.Date

  approvalStatus  ApprovalStatus @default(PENDING) @map("approval_status")
  reviewedById    Int?           @map("reviewed_by")
  reviewedAt      DateTime?      @map("reviewed_at")
  managerById     Int?           @map("manager_by")
  managerAt       DateTime?      @map("manager_at")
  approvedById    Int?           @map("approved_by")
  approvedAt      DateTime?      @map("approved_at")
  rejectedById    Int?           @map("rejected_by")
  rejectedAt      DateTime?      @map("rejected_at")
  rejectionReason String?        @map("rejection_reason")
  version         Int            @default(0)
  createdById     Int            @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  account    MoneyAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  movements  MoneyMovement[]
  createdBy  User            @relation("OtherCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy User?           @relation("OtherReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  managerBy  User?           @relation("OtherManagerBy", fields: [managerById], references: [id], onDelete: Restrict)
  approvedBy User?           @relation("OtherApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy User?           @relation("OtherRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)

  @@index([approvalStatus])
  @@map("other_movements")
}

// ───────────────────────── Finance: office expenses ─────────────────────────
// Salaries and advances are paid in EGP from a cash box or a bank account; general
// expenses from the EGP cash box only. Each one posts its ledger line on save.

/// One month's salary of one employee, paid once (UNIQUE employee + month).
model SalaryPayment {
  id               Int      @id @default(autoincrement())
  employeeId       Int      @map("employee_id")
  salaryMonth      DateTime @map("salary_month") @db.Date // the 1st of the month
  basic            Decimal  @db.Decimal(14, 2) // the employee's basic salary when paid
  /// [{ kind: BONUS | OVERTIME | PENALTY | ABSENCE, amount, reason }]
  adjustments      Json     @default("[]")
  additions        Decimal  @default(0) @db.Decimal(14, 2)
  deductions       Decimal  @default(0) @db.Decimal(14, 2)
  advanceDeduction Decimal  @default(0) @map("advance_deduction") @db.Decimal(14, 2)
  net              Decimal  @db.Decimal(14, 2) // basic + additions − deductions − advance deduction
  accountId        Int      @map("account_id")
  currency         Currency @default(EGP)
  paymentDate      DateTime @map("payment_date") @db.Date
  notes            String?

  approvalStatus  ApprovalStatus @default(PENDING) @map("approval_status")
  reviewedById    Int?           @map("reviewed_by")
  reviewedAt      DateTime?      @map("reviewed_at")
  managerById     Int?           @map("manager_by")
  managerAt       DateTime?      @map("manager_at")
  approvedById    Int?           @map("approved_by")
  approvedAt      DateTime?      @map("approved_at")
  rejectedById    Int?           @map("rejected_by")
  rejectedAt      DateTime?      @map("rejected_at")
  rejectionReason String?        @map("rejection_reason")
  version         Int            @default(0)
  createdById     Int            @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  account    MoneyAccount    @relation(fields: [accountId, currency], references: [id, currency], onDelete: Restrict)
  movements  MoneyMovement[]
  createdBy  User            @relation("SalaryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy User?           @relation("SalaryReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  managerBy  User?           @relation("SalaryManagerBy", fields: [managerById], references: [id], onDelete: Restrict)
  approvedBy User?           @relation("SalaryApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy User?           @relation("SalaryRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)

  @@unique([employeeId, salaryMonth])
  @@index([approvalStatus])
  @@map("salary_payments")
}

/// An advance paid to an employee; repaid only by deductions from salaries.
model EmployeeAdvance {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  amount      Decimal  @db.Decimal(14, 2)
  advanceDate DateTime @map("advance_date") @db.Date
  accountId   Int      @map("account_id")
  currency    Currency @default(EGP)
  notes       String?

  approvalStatus  ApprovalStatus @default(PENDING) @map("approval_status")
  reviewedById    Int?           @map("reviewed_by")
  reviewedAt      DateTime?      @map("reviewed_at")
  managerById     Int?           @map("manager_by")
  managerAt       DateTime?      @map("manager_at")
  approvedById    Int?           @map("approved_by")
  approvedAt      DateTime?      @map("approved_at")
  rejectedById    Int?           @map("rejected_by")
  rejectedAt      DateTime?      @map("rejected_at")
  rejectionReason String?        @map("rejection_reason")
  version         Int            @default(0)
  createdById     Int            @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  account    MoneyAccount    @relation(fields: [accountId, currency], references: [id, currency], onDelete: Restrict)
  movements  MoneyMovement[]
  createdBy  User            @relation("AdvanceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy User?           @relation("AdvanceReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  managerBy  User?           @relation("AdvanceManagerBy", fields: [managerById], references: [id], onDelete: Restrict)
  approvedBy User?           @relation("AdvanceApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy User?           @relation("AdvanceRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([approvalStatus])
  @@map("employee_advances")
}

/// The expense type lists; a type typed for the first time is added automatically.
model ExpenseType {
  id        Int          @id @default(autoincrement())
  name      String
  scope     ExpenseScope
  createdAt DateTime     @default(now()) @map("created_at")

  generalExpenses GeneralExpense[]
  custodyItems    CustodyItem[]
  settlementItem  SettlementItem?

  @@unique([scope, name])
  @@map("expense_types")
}

/// Office expenses (petty cash included), paid from the EGP cash box.
model GeneralExpense {
  id            Int      @id @default(autoincrement())
  expenseTypeId Int      @map("expense_type_id")
  payee         String
  amount        Decimal  @db.Decimal(14, 2)
  receiptNo     String   @map("receipt_no")
  expenseDate   DateTime @map("expense_date") @db.Date
  accountId     Int      @map("account_id")
  currency      Currency @default(EGP)
  notes         String?

  approvalStatus  ApprovalStatus @default(PENDING) @map("approval_status")
  reviewedById    Int?           @map("reviewed_by")
  reviewedAt      DateTime?      @map("reviewed_at")
  managerById     Int?           @map("manager_by")
  managerAt       DateTime?      @map("manager_at")
  approvedById    Int?           @map("approved_by")
  approvedAt      DateTime?      @map("approved_at")
  rejectedById    Int?           @map("rejected_by")
  rejectedAt      DateTime?      @map("rejected_at")
  rejectionReason String?        @map("rejection_reason")
  version         Int            @default(0)
  createdById     Int            @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  expenseType ExpenseType     @relation(fields: [expenseTypeId], references: [id], onDelete: Restrict)
  account     MoneyAccount    @relation(fields: [accountId, currency], references: [id, currency], onDelete: Restrict)
  movements   MoneyMovement[]
  createdBy   User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy  User?           @relation("ExpenseReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  managerBy   User?           @relation("ExpenseManagerBy", fields: [managerById], references: [id], onDelete: Restrict)
  approvedBy  User?           @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy  User?           @relation("ExpenseRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)

  @@index([expenseDate])
  @@index([approvalStatus])
  @@map("general_expenses")
}

// ───────────────────────── Finance: custodies and clearers ─────────────────────────
// A custody is the only way an expense reaches a shipment. It is issued (money out),
// settled once with its items (the rest back, or a clearer's overspend paid out), and
// approved once, after settlement.

model Custody {
  id              Int             @id @default(autoincrement())
  custodyNo       String          @unique @map("custody_no") // CU26-0001
  shipmentId      Int             @map("shipment_id")
  holderType      CustodyHolder   @map("holder_type")
  agentEmployeeId Int?            @map("agent_employee_id")
  clearerId       Int?            @map("clearer_id")
  purpose         CustodyPurpose?
  sourceAccountId Int             @map("source_account_id")
  beneficiaryId   Int?            @map("beneficiary_id") // BANK_TRANSFER: the external account paid
  transferRef     String?         @map("transfer_ref") // the bank transfer / cheque reference
  currency        Currency
  amount          Decimal         @db.Decimal(14, 2)
  extraAmount     Decimal         @default(0) @map("extra_amount") @db.Decimal(14, 2) // a clearer's overspend, paid at settlement
  spentAmount     Decimal         @default(0) @map("spent_amount") @db.Decimal(14, 2)
  returnedAmount  Decimal         @default(0) @map("returned_amount") @db.Decimal(14, 2)
  status          CustodyStatus   @default(OPEN)
  issueDate       DateTime        @map("issue_date") @db.Date
  settlementDate  DateTime?       @map("settlement_date") @db.Date
  settledById     Int?            @map("settled_by")
  notes           String?

  approvalStatus  ApprovalStatus @default(PENDING) @map("approval_status")
  reviewedById    Int?           @map("reviewed_by")
  reviewedAt      DateTime?      @map("reviewed_at")
  managerById     Int?           @map("manager_by")
  managerAt       DateTime?      @map("manager_at")
  approvedById    Int?           @map("approved_by")
  approvedAt      DateTime?      @map("approved_at")
  rejectedById    Int?           @map("rejected_by")
  rejectedAt      DateTime?      @map("rejected_at")
  rejectionReason String?        @map("rejection_reason")
  version         Int            @default(0)
  createdById     Int            @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  shipment      Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  agent         Employee?       @relation(fields: [agentEmployeeId], references: [id], onDelete: Restrict)
  clearer       Clearer?        @relation(fields: [clearerId], references: [id], onDelete: Restrict)
  sourceAccount MoneyAccount    @relation(fields: [sourceAccountId, currency], references: [id, currency], onDelete: Restrict)
  beneficiary   Beneficiary?    @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  settledBy     User?           @relation("CustodySettledBy", fields: [settledById], references: [id], onDelete: Restrict)
  items         CustodyItem[]
  movements     MoneyMovement[]
  computedFee   ClearerFee?
  createdBy     User            @relation("CustodyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy    User?           @relation("CustodyReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  managerBy     User?           @relation("CustodyManagerBy", fields: [managerById], references: [id], onDelete: Restrict)
  approvedBy    User?           @relation("CustodyApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy    User?           @relation("CustodyRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@index([clearerId])
  @@index([agentEmployeeId])
  @@index([status, approvalStatus])
  @@map("custodies")
}

/// One settlement line: expense type, amount, receipt number and/or description.
model CustodyItem {
  id               Int          @id @default(autoincrement())
  custodyId        Int          @map("custody_id")
  lineNo           Int          @map("line_no")
  expenseTypeId    Int          @map("expense_type_id")
  /// a fixed-price settlement item (clearer custodies): its price × quantity, frozen here
  settlementItemId Int?         @map("settlement_item_id")
  quantity         Int          @default(1)
  amount           Decimal      @db.Decimal(14, 2)
  receiptNo        String?      @map("receipt_no") // "861-26": digits and dashes
  receiptKind      ReceiptKind? @map("receipt_kind")
  description      String?

  custody           Custody            @relation(fields: [custodyId], references: [id], onDelete: Cascade)
  expenseType       ExpenseType        @relation(fields: [expenseTypeId], references: [id], onDelete: Restrict)
  settlementItem    SettlementItem?    @relation(fields: [settlementItemId], references: [id], onDelete: Restrict)
  statementOverride StatementOverride?

  @@unique([custodyId, lineNo])
  @@index([receiptNo])
  @@map("custody_items")
}

/// The clearer's fee on a shipment: once (UNIQUE shipment), priced when computed.
model ClearerFee {
  id              Int      @id @default(autoincrement())
  shipmentId      Int      @unique @map("shipment_id")
  clearerId       Int      @map("clearer_id")
  custodyId       Int      @unique @map("custody_id") // the settlement it was computed with
  base            Decimal  @db.Decimal(14, 2)
  extraRate       Decimal  @map("extra_rate") @db.Decimal(14, 2) // 0 when extra containers do not count
  containersCount Int      @map("containers_count")
  amount          Decimal  @db.Decimal(14, 2) // base + extra rate × (containers − 1)
  computedById    Int      @map("computed_by")
  createdAt       DateTime @default(now()) @map("created_at")

  shipment    Shipment               @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  clearer     Clearer                @relation(fields: [clearerId], references: [id], onDelete: Restrict)
  custody     Custody                @relation(fields: [custodyId], references: [id], onDelete: Restrict)
  computedBy  User                   @relation("FeeComputedBy", fields: [computedById], references: [id], onDelete: Restrict)
  adjustments ClearerFeeAdjustment[]
  payments    ClearerFeePayment[]

  @@index([clearerId])
  @@map("clearer_fees")
}

/// A change to a fee: containers count changed by SCAN, or a CEO override (with its reason).
model ClearerFeeAdjustment {
  id             Int                 @id @default(autoincrement())
  feeId          Int                 @map("fee_id")
  amount         Decimal             @db.Decimal(14, 2) // + or −, never 0
  reason         FeeAdjustmentReason
  containersFrom Int?                @map("containers_from")
  containersTo   Int?                @map("containers_to")
  notes          String?
  adjustmentDate DateTime            @map("adjustment_date") @db.Date

  approvalStatus  ApprovalStatus @default(PENDING) @map("approval_status")
  reviewedById    Int?           @map("reviewed_by")
  reviewedAt      DateTime?      @map("reviewed_at")
  managerById     Int?           @map("manager_by")
  managerAt       DateTime?      @map("manager_at")
  approvedById    Int?           @map("approved_by")
  approvedAt      DateTime?      @map("approved_at")
  rejectedById    Int?           @map("rejected_by")
  rejectedAt      DateTime?      @map("rejected_at")
  rejectionReason String?        @map("rejection_reason")
  version         Int            @default(0)
  createdById     Int            @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  fee        ClearerFee @relation(fields: [feeId], references: [id], onDelete: Restrict)
  createdBy  User       @relation("FeeAdjCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy User?      @relation("FeeAdjReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  managerBy  User?      @relation("FeeAdjManagerBy", fields: [managerById], references: [id], onDelete: Restrict)
  approvedBy User?      @relation("FeeAdjApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy User?      @relation("FeeAdjRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)

  @@index([feeId])
  @@map("clearer_fee_adjustments")
}

/// A fee payment to the clearer, from the EGP cash box; installments allowed.
model ClearerFeePayment {
  id            Int      @id @default(autoincrement())
  feeId         Int      @map("fee_id")
  amount        Decimal  @db.Decimal(14, 2)
  accountId     Int      @map("account_id")
  currency      Currency @default(EGP)
  paymentDate   DateTime @map("payment_date") @db.Date
  /// paid by bank transfer: the clearer account and the transfer reference
  beneficiaryId Int?     @map("beneficiary_id")
  transferRef   String?  @map("transfer_ref")
  notes         String?

  approvalStatus  ApprovalStatus @default(PENDING) @map("approval_status")
  reviewedById    Int?           @map("reviewed_by")
  reviewedAt      DateTime?      @map("reviewed_at")
  managerById     Int?           @map("manager_by")
  managerAt       DateTime?      @map("manager_at")
  approvedById    Int?           @map("approved_by")
  approvedAt      DateTime?      @map("approved_at")
  rejectedById    Int?           @map("rejected_by")
  rejectedAt      DateTime?      @map("rejected_at")
  rejectionReason String?        @map("rejection_reason")
  version         Int            @default(0)
  createdById     Int            @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  fee         ClearerFee      @relation(fields: [feeId], references: [id], onDelete: Restrict)
  account     MoneyAccount    @relation(fields: [accountId, currency], references: [id, currency], onDelete: Restrict)
  beneficiary Beneficiary?    @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  movements   MoneyMovement[]
  createdBy   User            @relation("FeePayCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy  User?           @relation("FeePayReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  managerBy   User?           @relation("FeePayManagerBy", fields: [managerById], references: [id], onDelete: Restrict)
  approvedBy  User?           @relation("FeePayApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy  User?           @relation("FeePayRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)

  @@index([feeId])
  @@map("clearer_fee_payments")
}

/// External bank accounts the office pays into: shipping agencies, clearers, others.
/// Picked on bank-transfer custodies and fee payments; a new one is added from there.
model Beneficiary {
  id            Int             @id @default(autoincrement())
  name          String
  kind          BeneficiaryKind
  clearerId     Int?            @map("clearer_id") // kind CLEARER: whose account it is
  bankName      String          @map("bank_name")
  accountNumber String          @map("account_number") // account number or IBAN
  isActive      Boolean         @default(true) @map("is_active")
  notes         String?
  createdById   Int             @map("created_by")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  clearer     Clearer?            @relation(fields: [clearerId], references: [id], onDelete: Restrict)
  createdBy   User                @relation("BeneficiaryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  custodies   Custody[]
  feePayments ClearerFeePayment[]

  @@unique([bankName, accountNumber])
  @@map("beneficiaries")
}

// ───────────────────────── Finance: shipment account and the client ─────────────────────────
// Actual shipment expenses are the custody settlement items. The client statement is built
// from them: the accountant may drop an item, change its amount / description, or add lines;
// the actual expense never changes. "Finish" freezes the statement into invoices.

model ShipmentAccount {
  shipmentId    Int                   @id @map("shipment_id")
  status        ShipmentAccountStatus @default(OPEN)
  paymentStatus PaymentStatus         @default(UNPAID) @map("payment_status")
  finishedAt    DateTime?             @map("finished_at")
  finishedById  Int?                  @map("finished_by")
  reopenCount   Int                   @default(0) @map("reopen_count")
  notes         String?
  version       Int                   @default(0)
  updatedAt     DateTime              @updatedAt @map("updated_at")

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  finishedBy User?    @relation("AccountFinishedBy", fields: [finishedById], references: [id], onDelete: Restrict)

  @@map("shipment_accounts")
}

/// How one settlement item shows on the client statement: dropped, or another amount / description.
model StatementOverride {
  custodyItemId Int      @id @map("custody_item_id")
  excluded      Boolean  @default(false)
  description   String?
  amount        Decimal? @db.Decimal(14, 2)
  updatedById   Int      @map("updated_by")
  updatedAt     DateTime @updatedAt @map("updated_at")

  custodyItem CustodyItem @relation(fields: [custodyItemId], references: [id], onDelete: Cascade)
  updatedBy   User        @relation("OverrideBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("statement_overrides")
}

/// A client statement line that is not a custody item.
model StatementExtraLine {
  id          Int      @id @default(autoincrement())
  shipmentId  Int      @map("shipment_id")
  currency    Currency
  description String
  amount      Decimal  @db.Decimal(14, 2)
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  shipment  Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  createdBy User     @relation("ExtraLineBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@map("statement_extra_lines")
}

/// STATEMENT (EGP / USD) and CLEARANCE (EGP) of a shipment; a reopen voids them (kept in the record).
model Invoice {
  id          Int         @id @default(autoincrement())
  shipmentId  Int         @map("shipment_id")
  type        InvoiceType
  currency    Currency
  invoiceNo   String      @map("invoice_no") // IMP440944/2026[-USD] or HL0447
  cycle       Int         @default(1) // CLEARANCE: HL0001 … HL9999, then again with the next cycle
  invoiceDate DateTime    @map("invoice_date") @db.Date
  valueDate   DateTime?   @map("value_date") @db.Date
  customerRef String?     @map("customer_ref")
  subtotal    Decimal     @db.Decimal(14, 2)
  vatRate     Decimal     @default(0) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount   Decimal     @default(0) @map("vat_amount") @db.Decimal(14, 2)
  wht         Decimal     @default(0) @db.Decimal(14, 2)
  total       Decimal     @db.Decimal(14, 2)
  notes       String?
  voidedAt    DateTime?   @map("voided_at")
  voidedById  Int?        @map("voided_by")

  approvalStatus  ApprovalStatus @default(PENDING) @map("approval_status")
  reviewedById    Int?           @map("reviewed_by")
  reviewedAt      DateTime?      @map("reviewed_at")
  managerById     Int?           @map("manager_by")
  managerAt       DateTime?      @map("manager_at")
  approvedById    Int?           @map("approved_by")
  approvedAt      DateTime?      @map("approved_at")
  rejectedById    Int?           @map("rejected_by")
  rejectedAt      DateTime?      @map("rejected_at")
  rejectionReason String?        @map("rejection_reason")
  version         Int            @default(0)
  createdById     Int            @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  shipment   Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  voidedBy   User?         @relation("InvoiceVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  lines      InvoiceLine[]
  createdBy  User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy User?         @relation("InvoiceReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  managerBy  User?         @relation("InvoiceManagerBy", fields: [managerById], references: [id], onDelete: Restrict)
  approvedBy User?         @relation("InvoiceApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy User?         @relation("InvoiceRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@map("invoices")
}

model InvoiceLine {
  id            Int     @id @default(autoincrement())
  invoiceId     Int     @map("invoice_id")
  lineNo        Int     @map("line_no")
  description   String
  quantity      Decimal @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal @map("unit_price") @db.Decimal(14, 2)
  total         Decimal @db.Decimal(14, 2) // quantity × unit price, before VAT
  custodyItemId Int?    @map("custody_item_id") // statement lines built from a settlement item

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNo])
  @@map("invoice_lines")
}

/// Money received from a client against a shipment, in the invoice currency.
model Collection {
  id             Int              @id @default(autoincrement())
  clientId       Int              @map("client_id")
  shipmentId     Int              @map("shipment_id")
  currency       Currency
  amount         Decimal          @db.Decimal(14, 2)
  method         CollectionMethod
  accountId      Int              @map("account_id")
  collectionDate DateTime         @map("collection_date") @db.Date
  reference      String?
  notes          String?

  approvalStatus  ApprovalStatus @default(PENDING) @map("approval_status")
  reviewedById    Int?           @map("reviewed_by")
  reviewedAt      DateTime?      @map("reviewed_at")
  managerById     Int?           @map("manager_by")
  managerAt       DateTime?      @map("manager_at")
  approvedById    Int?           @map("approved_by")
  approvedAt      DateTime?      @map("approved_at")
  rejectedById    Int?           @map("rejected_by")
  rejectedAt      DateTime?      @map("rejected_at")
  rejectionReason String?        @map("rejection_reason")
  version         Int            @default(0)
  createdById     Int            @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  client     Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  shipment   Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  account    MoneyAccount    @relation(fields: [accountId, currency], references: [id, currency], onDelete: Restrict)
  movements  MoneyMovement[]
  createdBy  User            @relation("CollectionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy User?           @relation("CollectionReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  managerBy  User?           @relation("CollectionManagerBy", fields: [managerById], references: [id], onDelete: Restrict)
  approvedBy User?           @relation("CollectionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy User?           @relation("CollectionRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([shipmentId])
  @@map("collections")
}

/// أتعاب المستخلص: sea imports through Alexandria or El Dekheila, by customs regime.
/// Set by the CEO; a fee keeps the prices it was computed with.
model ClearerFeeRate {
  regime         CustomsRegime @id
  firstContainer Decimal       @map("first_container") @db.Decimal(14, 2)
  extraContainer Decimal       @map("extra_container") @db.Decimal(14, 2)
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("clearer_fee_rates")
}

/// بنود التصفية: fixed-price items a clearer's custody is settled with, once per
/// shipment each. Set by the CEO; settled custodies keep the price they were settled at.
model SettlementItem {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  price         Decimal  @db.Decimal(14, 2)
  perContainer  Boolean  @default(false) @map("per_container")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  /// the shipment expense type its custody lines are filed under (same name)
  expenseTypeId Int      @unique @map("expense_type_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  expenseType  ExpenseType   @relation(fields: [expenseTypeId], references: [id], onDelete: Restrict)
  custodyItems CustodyItem[]

  @@map("settlement_items")
}
